+def load_model(args):
+    """Load one reusable model while preserving the CLI defaults."""
+    load_args = argparse.Namespace(**vars(args))
+    load_args._load_only = True
+    return main(load_args)
+
+
+def run_design(args, resident):
+    """Run one design request with a model returned by load_model()."""
+    run_args = argparse.Namespace(**vars(args))
+    run_args._resident_model = resident
+    return main(run_args)
+
