+def _aa_bias_value(S, positions, specs):
+    """Saturating proposal reward. Never changes the model's reported energy."""
+    value = 0.0
+    for token_mask, weight, cap in specs:
+        count = int(token_mask[S[list(positions)]].sum())
+        value -= weight * (min(count, cap) if cap is not None else count)
+    return value
+
+
+def _aa_bias_block(ctx, S, positions, block, specs):
+    shape = [ctx.V] * len(block)
+    out = torch.zeros(shape, device=ctx.device)
+    outside = [p for p in positions if p not in set(block)]
+    for token_mask, weight, cap in specs:
+        count = torch.full(shape, int(token_mask[S[outside]].sum()), device=ctx.device)
+        for bi in range(len(block)):
+            axis = [1] * len(block)
+            axis[bi] = ctx.V
+            count = count + token_mask.reshape(axis)
+        if cap is not None:
+            count = count.clamp(max=cap)
+        out = out - weight * count
+    return out
+
+
+def _mutation_budget_block(ctx, S, block, references):
+    """Mask full joint assignments, never trim individual edits after solving."""
+    shape = [ctx.V] * len(block)
+    allowed = torch.ones(shape, dtype=torch.bool, device=ctx.device)
+    canon = ctx.canonical_map
+    for ref, cap in references:
+        different = canon[S] != canon[ref]
+        outside = int(different.sum()) - int(different[list(block)].sum())
+        count = torch.full(shape, outside, device=ctx.device)
+        for bi, p in enumerate(block):
+            axis = [1] * len(block)
+            axis[bi] = ctx.V
+            count = count + (canon != canon[ref[p]]).reshape(axis)
+        allowed = allowed & (count <= cap)
+    return allowed
