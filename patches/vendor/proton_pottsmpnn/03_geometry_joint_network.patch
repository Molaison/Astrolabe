+def _network_pair_specs(ctx, crit, neigh):
+    """Map zero-based binder preferences to context positions and token masks."""
+    binder_positions = [
+        int(position)
+        for position in ctx.chainA_t.nonzero(as_tuple=False).reshape(-1).tolist()
+    ]
+    if not binder_positions:
+        raise ValueError("network_pair_preferences require a non-empty binder chain.")
+    mutable = {int(position) for position in neigh}
+    roles = {"HIS", "LYS", "ARG"}
+    specs = []
+    for index, preference in enumerate(crit.network_pair_preferences):
+        i, j = int(preference["i"]), int(preference["j"])
+        if i >= len(binder_positions) or j >= len(binder_positions):
+            raise ValueError(
+                f"network_pair_preferences[{index}] index is outside binder length "
+                f"{len(binder_positions)}."
+            )
+        aa_i, aa_j = str(preference["aa_i"]), str(preference["aa_j"])
+        if aa_i not in roles or aa_j not in roles:
+            raise ValueError(
+                f"network_pair_preferences[{index}] contains an invalid AA role."
+            )
+        position_i, position_j = binder_positions[i], binder_positions[j]
+        if position_i not in mutable and position_j not in mutable:
+            raise ValueError(
+                f"network_pair_preferences[{index}] has no mutable endpoint."
+            )
+        mask_i = _parent_vocab_mask(ctx, [aa_i]).to(ctx.device)
+        mask_j = _parent_vocab_mask(ctx, [aa_j]).to(ctx.device)
+        for position, mask, role in (
+            (position_i, mask_i, aa_i),
+            (position_j, mask_j, aa_j),
+        ):
+            if position not in mutable and not bool(mask[int(ctx.S_native[position])]):
+                raise ValueError(
+                    f"network_pair_preferences[{index}] fixed endpoint {position} "
+                    f"does not currently match {role}."
+                )
+        specs.append(
+            (
+                position_i,
+                position_j,
+                mask_i,
+                mask_j,
+                float(preference["quality"]),
+            )
+        )
+    return specs
+
+
+def _network_pair_match_value(S, specs):
+    """Best configured pair match quality; max, never a sum over preferences."""
+    best = 0.0
+    for position_i, position_j, mask_i, mask_j, quality in specs:
+        if bool(mask_i[S[position_i]]) and bool(mask_j[S[position_j]]):
+            best = max(best, float(quality))
+    return best
+
+
+def _network_pair_bias_block(ctx, S, block, specs, weight):
+    """Exact negative pair reward over a block, with all non-block endpoints frozen."""
+    if not specs:
+        return torch.zeros([ctx.V] * len(block), device=ctx.device)
+    shape = [ctx.V] * len(block)
+    block_index = {int(position): index for index, position in enumerate(block)}
+    best = torch.zeros(shape, device=ctx.device)
+    for position_i, position_j, mask_i, mask_j, quality in specs:
+        term = torch.full(shape, float(quality), device=ctx.device)
+        for position, mask in ((position_i, mask_i), (position_j, mask_j)):
+            if position in block_index:
+                axis = [1] * len(block)
+                axis[block_index[position]] = ctx.V
+                term = term * mask.reshape(axis).to(term.dtype)
+            elif not bool(mask[S[position]]):
+                term = torch.zeros_like(term)
+        best = torch.maximum(best, term)
+    return -float(weight) * best
+
