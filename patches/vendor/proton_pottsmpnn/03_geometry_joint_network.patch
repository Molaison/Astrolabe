+            S,
+            block,
+            pair_specs,
+            float(crit.network_pair_bias),
+        )
+        if references:
+            potential = potential.masked_fill(
+                ~_mutation_budget_block(ctx, S, block, references),
+                float("inf"),
+            )
+        if want_rep:
+            residue_ids = [int(res_id[position]) for position in block]
+            pair_penalty = (
+                same_canon
+                if rep_all
+                else (
+                    torch.outer(rep_mask, rep_mask)
+                    if rep_mask is not None
+                    else None
+                )
+            )
+            if pair_penalty is not None:
+                for block_i in range(size):
+                    for block_j in range(block_i + 1, size):
+                        if abs(residue_ids[block_i] - residue_ids[block_j]) <= rrad:
+                            shape = [1] * size
+                            shape[block_i] = V
+                            shape[block_j] = V
+                            potential = potential + (
+                                rw * pair_penalty
+                            ).reshape(shape)
+        for block_index in range(size):
+            shape = [1] * size
+            shape[block_index] = V
+            potential = potential + inf_vec.reshape(shape)
+        return potential
+
+    best_sequence = S.clone()
+    best_objective = objective(S)
+    _record(trajectory, ctx, S, pins, initial=True)
+    patience = crit.cv_patience * len(neigh)
+    cap = min(crit.cv_max * len(neigh), int(crit.network_pair_max_steps))
+    since = step = pair_steps = 0
