+        step += 1
+        current = objective(S)
+        if current < best_objective - 1e-9:
+            best_objective = current
+            best_sequence = S.clone()
+            since = 0
+        else:
+            since += 1
+        _record(trajectory, ctx, S, pins)
+    return best_sequence
