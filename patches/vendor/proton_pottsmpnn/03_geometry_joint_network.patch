+        improving = []
+        for position in neigh:
+            energy = wH * stab_scorer.cond_energy_at(S, int(position))
+            if aa_specs and int(position) in aa_positions:
+                energy = energy + _aa_bias_block(
+                    ctx, S, aa_positions, [int(position)], aa_specs
+                )
+            if int(position) in pair_endpoints:
+                energy = energy + _network_pair_bias_block(
+                    ctx,
+                    S,
+                    [int(position)],
+                    pair_specs,
+                    float(crit.network_pair_bias),
+                )
+            current = int(S[int(position)])
+            candidate_energy = energy.clone()
+            candidate_energy[invalid] = float("inf")
+            if references:
+                candidate_energy[
+                    ~_mutation_budget_block(ctx, S, [int(position)], references)
+                ] = float("inf")
+            delta = float(candidate_energy.min()) - float(energy[current])
+            if delta < -tol:
+                improving.append((delta, int(position)))
+
+        candidate_blocks = {}
+        if improving:
+            improving.sort(key=lambda item: (item[0], item[1]))
+            candidate_blocks[
+                tuple(sorted(position for _, position in improving[:K]))
+            ] = False
+        if pair_steps < int(crit.network_pair_max_steps):
+            mutable = {int(position) for position in neigh}
+            for position_i, position_j, *_ in pair_specs:
+                block = tuple(
+                    sorted(
+                        position
+                        for position in (position_i, position_j)
+                        if position in mutable
+                    )
+                )
+                if block:
+                    candidate_blocks[block] = True
+        if not candidate_blocks:
+            break
+
+        evaluated = []
+        for block, is_pair in candidate_blocks.items():
+            potential = joint_block(block)
+            flat = potential.reshape(-1)
+            if not bool(torch.isfinite(flat).any()):
+                continue
+            best_choice = int(torch.argmin(flat))
+            best_value = float(flat[best_choice])
+            current_choice = tuple(int(S[position]) for position in block)
+            current_index = int(
+                np.ravel_multi_index(current_choice, [V] * len(block))
+            )
+            current_value = float(flat[current_index])
+            if best_value >= current_value - tol:
+                continue
+            evaluated.append(
+                {
+                    "block": block,
+                    "is_pair": is_pair,
+                    "potential": potential,
+                    "best_choice": best_choice,
+                    "current_index": current_index,
+                    "current_value": current_value,
+                    "delta": best_value - current_value,
+                }
+            )
+        if not evaluated:
+            break
+        evaluated.sort(
+            key=lambda item: (item["delta"], item["block"], item["best_choice"])
+        )
+        selected = evaluated[0]
+        block = selected["block"]
+        potential = selected["potential"]
+        flat = potential.reshape(-1)
+        current_value = selected["current_value"]
+        if T <= 0:
