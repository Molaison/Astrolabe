+        rep_all
+        or (
+            bool(rw_parents)
+            and (not rw_gate or any(p.protonation_type in rw_gate for p in pins))
+        )
+    )
+    rrad = max(1, int(crit.repetitive_window_radius))
+    canonical_map = ctx.canonical_map
+    same_canon = (
+        (canonical_map.view(-1, 1) == canonical_map.view(1, -1)).float().to(ctx.device)
+        if want_rep and rep_all
+        else None
+    )
+    rep_mask = (
+        _parent_vocab_mask(ctx, rw_parents).float()
+        if want_rep and not rep_all
+        else None
+    )
+    res_id = ctx.token_aa.res_id
+    invalid = ~valid_mask
+    inf_vec = torch.where(
+        invalid,
+        torch.tensor(float("inf"), device=ctx.device),
+        torch.zeros(V, device=ctx.device),
+    )
+    pair_specs = _network_pair_specs(ctx, crit, neigh)
+    S = initial_sequence.clone()
+    if not neigh:
+        return S
+    for position in neigh:
+        current = int(S[int(position)])
+        canonical = int(canonical_map[current])
+        if bool(valid_mask[canonical]):
+            S[int(position)] = canonical
+        elif not bool(valid_mask[current]):
+            alternatives = valid_mask & (canonical_map == canonical)
+            if not bool(alternatives.any()):
+                raise ValueError("No allowed token represents an existing mutable amino acid.")
+            energies = stab_scorer.cond_energy_at(S, int(position)).clone()
+            energies[~alternatives] = float("inf")
+            S[int(position)] = int(torch.argmin(energies))
+    dH0, _, _ = _block_mutation_tables(ctx, valid_mask, S, neigh, [], False)
+    wH = 1.0 / _zscale(dH0, valid_mask)
+    aa_specs = [
+        (_parent_vocab_mask(ctx, [aa]), float(weight), crit.aa_bias_caps.get(aa))
+        for aa, weight in crit.aa_bias.items()
+        if float(weight) != 0.0
+    ]
+    aa_mask = ctx.region_mask(crit.aa_bias_region) if aa_specs else None
+    aa_positions = (
+        [int(position) for position in neigh if bool(aa_mask[position])]
+        if aa_specs
+        else []
+    )
+    pair_endpoints = {
+        position
+        for position_i, position_j, *_ in pair_specs
+        for position in (position_i, position_j)
+    }
+    references = []
+    if crit.max_mutations:
+        references.append((initial_sequence, int(crit.max_mutations)))
+    if crit.max_total_mutations is not None:
+        reference = ctx.encode_initial_sequence(crit.mutation_reference_sequence)
+        references.append((reference, int(crit.max_total_mutations)))
+    for reference, limit in references:
+        if int((canonical_map[S] != canonical_map[reference]).sum()) > limit:
+            raise ValueError("Initial sequence exceeds the declared mutation-reference budget.")
+
+    def objective(sequence):
+        value = wH * stab_scorer.H_of(sequence)
+        if aa_specs:
+            value += _aa_bias_value(sequence, aa_positions, aa_specs)
+        value -= float(crit.network_pair_bias) * _network_pair_match_value(
+            sequence, pair_specs
+        )
+        return value
+
+    def joint_block(block):
+        unary, edges = stab_scorer.block_stability_potentials(S, block)
+        combined = wH * unary
+        block_set = set(block)
+        if want_rep:
+            for block_index, position in enumerate(block):
+                residue_id = int(res_id[position])
+                for delta in range(-rrad, rrad + 1):
+                    if delta == 0:
+                        continue
+                    neighbour = ctx.res_id_to_pos.get(residue_id + delta)
+                    if neighbour is None or int(neighbour) in block_set:
+                        continue
+                    if rep_all:
+                        combined[block_index] += (
+                            rw * same_canon[:, int(S[int(neighbour)])]
+                        )
+                    elif bool(rep_mask[int(S[int(neighbour)])]):
+                        combined[block_index] += rw * rep_mask
+        size = len(block)
+        potential = combined[0].clone().reshape([V] + [1] * (size - 1))
+        for block_index in range(1, size):
+            shape = [1] * size
+            shape[block_index] = V
+            potential = potential + combined[block_index].reshape(shape)
+        for block_i, block_j, pair_matrix in edges:
+            shape = [1] * size
+            shape[block_i] = V
+            shape[block_j] = V
+            potential = potential + (wH * pair_matrix).reshape(shape)
+        if aa_specs:
+            active = [position for position in block if position in aa_positions]
+            if active:
+                potential = potential + _aa_bias_block(
